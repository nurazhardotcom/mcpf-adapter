;; mcpf-adapter configuration
;;
;; Loaded by cli.bb at startup. Any field missing here falls back to
;; the built-in defaults defined in cli.bb.

{
 ;; Default list of search queries the operator iterates over.
 ;; Tuned for SG GRC/compliance/risk bullshit roles (2026-07-19).
 ;; Goal: high-paying low-cognitive-load governance jobs at SG-licensed
 ;; MAS-regulated firms. Income extraction, not identity.
 ;;
 ;; cli.bb does not iterate over :queries automatically; external scripts
 ;; (e.g. a weekly cron or bb task) read this key and call `scrape` / `emit`
 ;; once per query. See README.md "Configuration" for an example.
 :queries
 ["compliance"
  "risk"
  "governance risk"
  "grc"
  "audit"
  "regulatory compliance"
  "internal control"
  "information security governance"
  "technology risk"
  "operational risk"
  "vendor risk"
  "third party risk"
  "data privacy"
  "data protection"
  "p d p a"
  "business continuity"
  "fraud"
  "sanctions"
  "identity access management"
   "security policy"
   "assurance"]

  ;; Number of listings requested per /v2/search POST.
 ;; MCF v2 appears to honor up to 50; lower values are slower but gentler.
 :page-size 50

 ;; Default number of pages to walk per scrape run.
 ;; At 50 listings × 5 pages = 250 listings per query.
 :default-pages 5

 ;; Politeness delay between paginations (milliseconds).
 ;; MCF v2 is an unofficial endpoint; conservative pacing is mandatory.
 :sleep-ms 3000

 ;; Browser-like User-Agent header.
 :user-agent "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

 ;; Minimum monthly SGD salary to include when emitting.
 ;; NOT enforced by cli.bb; reserved for downstream consumers that want a
 ;; quick salary floor without re-implementing the annualize logic.
 :salary-min-sgd 6000

 ;; Hard cap on total listings emitted per query (defensive).
 ;; NOT enforced by cli.bb; reserved for downstream consumers.
 :postings-per-query-cap 1000
}
